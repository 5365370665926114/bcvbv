{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "remotion:render": "remotion render src/remotion/index.ts DesmistificandoEpisode out/desmistificando_ep01.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "sfx:generate": "python3 scripts/generate_sfx.py --out-dir public",
    "transcribe": "python3 scripts/transcribe.py --audio public/narracao.mp3 --output public/transcript.json --engine faster-whisper"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@remotion/cli": "^4.0.545",
    "@remotion/google-fonts": "^4.0.545",
    "@remotion/noise": "^4.0.545",
    "@remotion/player": "^4.0.545",
    "@remotion/renderer": "^4.0.545",
    "@remotion/transitions": "^4.0.545",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "remotion": "^4.0.545",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
